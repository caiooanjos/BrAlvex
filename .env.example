# Copie para .env (fora do controle de versão) ou configure no painel da hospedagem. Nunca publique valores reais.

NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Endereço público do site (https em produção). Usado em canonical, links do aviso por e-mail e verificação de origem.
SITE_URL=https://bralvex.com
# Número de proxies reversos à frente do Node (ex.: 1 atrás do proxy da hospedagem). Necessário para cookie Secure e limites por IP.
TRUST_PROXY=1

# MySQL/MariaDB. Use 127.0.0.1 (não "localhost") quando o banco estiver no mesmo servidor.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bralvex
# Usuário da aplicação: somente SELECT, INSERT, UPDATE, DELETE (veja docs/database-setup.sql).
DB_USER=bralvex_app
DB_PASSWORD=
# Usuário opcional, com privilégios de DDL, usado apenas por "npm run migrate".
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
DB_CONNECTION_LIMIT=5

# Segredos aleatórios e diferentes entre si (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
FORM_TOKEN_SECRET=

# Sessão do painel: expira após inatividade e, em qualquer caso, após o limite absoluto.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
ADMIN_TIMEZONE=America/Sao_Paulo

# Proteções do formulário público.
FORM_TOKEN_MIN_SECONDS=3
FORM_TOKEN_MAX_HOURS=48
LEAD_RATE_WINDOW_MINUTES=10
LEAD_RATE_MAX=5
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX=10

# Prazo de retenção (dias). Deixe vazio até a BrAlveX definir a política.
LEAD_RETENTION_DAYS=

# Aviso de nova solicitação por e-mail. Sem SMTP_HOST, o aviso não é enviado e o lead fica marcado como "não enviado".
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM=
NOTIFY_TO=contact@bralvex.com
